        <mxCell id="3" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#334155;spacing=0;strokeColor=none;fillColor=none;" value="C4 Context (C1): люди и программные системы. Зелёные блоки — общие механизмы Privacy by Design." vertex="1">
          <mxGeometry height="30" width="1300" x="40" y="67" as="geometry" />
        </mxCell>
        <mxCell id="4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fillColor=#08427b;strokeColor=#06315b;strokeWidth=1.5;spacing=10;shadow=0;" value="&lt;b&gt;Пациент&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Самостоятельно записывается&lt;br&gt;и отменяет свой приём." vertex="1">
          <mxGeometry height="100" width="230" x="40" y="210" as="geometry" />
        </mxCell>
        <mxCell id="5" parent="1" style="shape=ellipse;html=1;fillColor=#08427b;strokeColor=#06315b;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="44" width="44" x="133" y="178" as="geometry" />
        </mxCell>
        <mxCell id="6" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fillColor=#08427b;strokeColor=#06315b;strokeWidth=1.5;spacing=10;shadow=0;" value="&lt;b&gt;Сотрудник ресепшена&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Ведёт записи и контакты;&lt;br&gt;за день напоминает пациенту и врачу." vertex="1">
          <mxGeometry height="110" width="230" x="40" y="410" as="geometry" />
        </mxCell>
        <mxCell id="7" parent="1" style="shape=ellipse;html=1;fillColor=#08427b;strokeColor=#06315b;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="44" width="44" x="133" y="378" as="geometry" />
        </mxCell>
        <mxCell id="8" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fillColor=#08427b;strokeColor=#06315b;strokeWidth=1.5;spacing=10;shadow=0;" value="&lt;b&gt;Врач&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Просматривает&lt;br&gt;своё расписание." vertex="1">
          <mxGeometry height="100" width="230" x="40" y="630" as="geometry" />
        </mxCell>
        <mxCell id="9" parent="1" style="shape=ellipse;html=1;fillColor=#08427b;strokeColor=#06315b;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="44" width="44" x="133" y="598" as="geometry" />
        </mxCell>
        <mxCell id="10" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fillColor=#1168bd;strokeColor=#0b4884;strokeWidth=1.5;spacing=10;shadow=0;" value="&lt;b&gt;Система записи «Медикаменте»&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Порталы пациента и ресепшена.&lt;br&gt;Пациенты, запись, отмена, расписание.&lt;br&gt;&lt;br&gt;Раздельные категории: контакты и записи.&lt;br&gt;На сервере — проверка роли и владельца&lt;br&gt;при каждом запросе." vertex="1">
          <mxGeometry height="230" width="470" x="440" y="350" as="geometry" />
        </mxCell>
        <mxCell id="11" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#163d27;fillColor=#e9f4ec;strokeColor=#548564;strokeWidth=1.5;spacing=10;shadow=0;" value="&lt;b&gt;Единый вход и роли&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Учётные записи пациентов.&lt;br&gt;Для сотрудников — SSO через AD.&lt;br&gt;Выдаёт подтверждённую роль." vertex="1">
          <mxGeometry height="145" width="300" x="400" y="125" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#163d27;fillColor=#e9f4ec;strokeColor=#548564;strokeWidth=1.5;spacing=10;shadow=0;" value="&lt;b&gt;Управление данными&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Каталог тегов и источников данных.&lt;br&gt;Цели, основания, сроки хранения&lt;br&gt;и единые правила обработки.&lt;br&gt;Категории: ПДн, медданные, расчёты." vertex="1">
          <mxGeometry height="160" width="330" x="800" y="125" as="geometry" />
        </mxCell>
        <mxCell id="13" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#163d27;fillColor=#e9f4ec;strokeColor=#548564;strokeWidth=1.5;spacing=10;shadow=0;" value="&lt;b&gt;Защищённая аналитика&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Закрытая подготовка: минимум полей,&lt;br&gt;обезличивание и проверка результата.&lt;br&gt;&lt;br&gt;Отчёты по записям и загрузке врачей.&lt;br&gt;Аналитику - только сводные данные,&lt;br&gt;без доступа к исходным ПДн." vertex="1">
          <mxGeometry height="210" width="380" x="1030" y="430" as="geometry" />
        </mxCell>
        <mxCell id="14" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#163d27;fillColor=#e9f4ec;strokeColor=#548564;strokeWidth=1.5;spacing=10;shadow=0;" value="&lt;b&gt;Аудит и оповещения&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Чтение, изменение, выгрузки и отказы.&lt;br&gt;Защищённый журнал без содержимого ПДн.&lt;br&gt;Выявление массовых чтений и выгрузок." vertex="1">
          <mxGeometry height="150" width="340" x="630" y="770" as="geometry" />
        </mxCell>
        <mxCell id="15" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fillColor=#08427b;strokeColor=#06315b;strokeWidth=1.5;spacing=10;shadow=0;" value="&lt;b&gt;Бизнес-аналитик&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Работает со сводными отчётами." vertex="1">
          <mxGeometry height="95" width="230" x="1170" y="815" as="geometry" />
        </mxCell>
        <mxCell id="16" parent="1" style="shape=ellipse;html=1;fillColor=#08427b;strokeColor=#06315b;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="44" width="44" x="1263" y="783" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#ffffff;fillColor=#08427b;strokeColor=#06315b;strokeWidth=1.5;spacing=10;shadow=0;" value="&lt;b&gt;Уполномоченный сотрудник IT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Получает сигналы о нарушениях." vertex="1">
          <mxGeometry height="85" width="240" x="700" y="982" as="geometry" />
        </mxCell>
        <mxCell id="18" parent="1" style="shape=ellipse;html=1;fillColor=#08427b;strokeColor=#06315b;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="44" width="44" x="798" y="950" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#334155;spacing=12;strokeColor=#cbd5e1;fillColor=#f8fafc;" value="&lt;p&gt;&lt;strong&gt;Общие правила защиты данных&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 140%;&quot;&gt;• Доступ разрешён только к данным, необходимым для работы. Пациент видит только свои записи.&lt;br&gt;• Собираем только необходимые сведения. Передачу защищаем TLS, хранимые данные - шифрованием.&lt;br&gt;• Каталог хранит теги и правила обработки. Системы используют их для проверки доступа и сроков хранения.&lt;br&gt;• Удаляем данные по истечении срока или запросу пациента, если закон не требует их сохранять.&lt;br&gt;• До выпуска проверяем запрет доступа к чужим данным, отсутствие персональных данных в аналитических отчётах и содержимого медкарт в журналах действий.&lt;/p&gt;" vertex="1">
          <mxGeometry height="270" width="480" x="40" y="770" as="geometry" />
        </mxCell>

  <diagram id="medikamente-mvp-context" name="C4 Context — MVP">
    <mxGraphModel dx="-34" dy="-364" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1130" background="#ffffff" math="0" shadow="0">
